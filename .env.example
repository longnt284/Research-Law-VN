# Mẫu biến môi trường. Chép thành .env.local cho máy phát triển; trên Vercel
# đặt ở Settings → Environment Variables. Không commit giá trị thật.

# Địa chỉ gốc của trang (canonical, sitemap, trang quay về sau thanh toán).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tài khoản người dùng (Supabase). Hai khóa công khai, dùng ở trình duyệt.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Trợ lý hỏi đáp: chỉ phía máy chủ (xem README, mục Trợ lý hỏi đáp).
CHAT_SKILLS_KEY=
CHAT_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
CHAT_API_KEY=
CHAT_FALLBACK_API_BASE=https://openrouter.ai/api/v1
CHAT_FALLBACK_API_KEY=
CHAT_FALLBACK_MODEL=openrouter/free

# Thanh toán và lượt Pro (xem docs/PAYMENTS.md). Chỉ phía máy chủ: không bao
# giờ thêm tiền tố NEXT_PUBLIC_ cho các biến này.
# Secret key của Supabase (sb_secret_…) hoặc khóa service_role cũ.
SUPABASE_SECRET_KEY=
# Khóa của kênh thanh toán trên my.payos.vn. Máy phát triển dùng kênh thử riêng.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
